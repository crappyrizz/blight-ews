<?xml version="1.0" encoding="utf-8"?>
<!--
  Release (and profile) builds: HTTPS only. The hosted API is
  https://blight-ews-api.onrender.com, so the farmer's password and login token
  always travel encrypted.

  Debug builds (flutter run) use src/debug/res/xml/network_security_config.xml
  instead, which allows plain HTTP to a backend on the developer's PC.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
