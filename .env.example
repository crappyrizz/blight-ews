# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection strings (psycopg 3 driver).
# If the password contains special characters (@ : / % #), URL-encode them.
DATABASE_URL=postgresql+psycopg://blight:CHANGE_ME@localhost:5432/blight_ews
# Separate database used only by pytest. Tables are created and DROPPED there.
TEST_DATABASE_URL=postgresql+psycopg://blight:CHANGE_ME@localhost:5432/blight_ews_test

# JWT auth for the mobile app. Use a long random string, e.g.:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=60

# Africa's Talking (username is "sandbox" during development)
AT_USERNAME=sandbox
AT_API_KEY=CHANGE_ME
AT_SENDER_ID=

# Farm site (Kinangop) and local timezone
SITE_LAT=-0.70
SITE_LON=36.60
TIMEZONE=Africa/Nairobi
